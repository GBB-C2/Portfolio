// Numeric resource types avoid a dependency on Windows C headers.
1 ICON "portfolio.ico"
1 24 "portfolio.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Portfolio - 2D painting studio\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "InternalName", "Portfolio\0"
            VALUE "OriginalFilename", "Portfolio.exe\0"
            VALUE "ProductName", "Portfolio\0"
            VALUE "ProductVersion", "0.1.0 preview\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
